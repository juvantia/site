---
// The header again, floating, on the way back up (desktop).
import DeckKey from '../vitrum/DeckKey.astro';
import NavTabs from './NavTabs.astro';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<div class="site-dock" data-dock>
  <span class="dock-plate" aria-hidden="true"></span>
  <div class="dock-inner">
    <a class="site-logo" href="/" aria-label="Juvantia Home"><img src="/images/logo.svg" alt="" width="36" height="36" /></a>
    <nav class="site-nav" aria-label="Sections">
      <NavTabs pathname={pathname} />
    </nav>
    {pathname === '/downloads' ? <span class="key--access head-key head-key-slot" aria-hidden="true"></span> : <DeckKey class="key--access head-key" href="/downloads" title="Downloads" label="Download Juvantia Clients" />}
  </div>
</div>

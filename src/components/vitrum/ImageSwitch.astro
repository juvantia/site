---
// Two photos of one subject fill a plate's side and cross-fade: flat controls and a count, never dots.
import Icon from './Icon.astro';

interface Props {
  images: { src: string; alt: string }[];
  ratio?: string;
}

const { images, ratio = '16 / 9' } = Astro.props;
const total = String(images.length).padStart(2, '0');
---

<figure class="plate-media" data-switch style={`--ratio: ${ratio}`}>
  {images.map((image, index) => (
    <img class:list={['switch-img', { 'is-on': index === 0 }]} src={image.src} alt={image.alt} loading="lazy" decoding="async" />
  ))}
  <div class="switch-bar">
    <button class="vt-flat" type="button" data-prev aria-label="Previous photo"><Icon name="chevron-left" /></button>
    <span class="switch-count" aria-live="polite"><b data-count>01</b> / {total}</span>
    <button class="vt-flat" type="button" data-next aria-label="Next photo"><Icon name="chevron-right" /></button>
  </div>
</figure>

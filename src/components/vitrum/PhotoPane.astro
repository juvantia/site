---
// A photo of the place with the plates' rim; nothing presses it. Its words, if any, sit at its foot on a dark plate.
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  ratio?: string;
  caption?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, width, height, ratio = `${width} / ${height}`, caption, eager = false, class: className = '' } = Astro.props;
---

<figure class:list={['photo-pane', className]} data-pane style={`--ratio: ${ratio}`}>
  <img src={src} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>

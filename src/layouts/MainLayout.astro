---
import '../styles/vitrum/tokens.css';
import '../styles/vitrum/world.css';
import '../styles/vitrum/layout.css';
import '../styles/vitrum/header.css';
import '../styles/vitrum/key.css';
import '../styles/vitrum/readout.css';
import '../styles/vitrum/plate.css';
import '../styles/vitrum/page.css';
import '../styles/vitrum/tabs.css';
import '../styles/vitrum/content.css';
import '../styles/vitrum/footer.css';
import '../styles/vitrum/phone-dock.css';
import '../styles/vitrum/motion.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/site/SiteHeader.astro';
import TopDock from '../components/site/TopDock.astro';
import PhoneDock from '../components/site/PhoneDock.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { currentPath } from '../components/site/nav';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'A free-to-enter, open-access physical proving ground for teleoperated rovers. Built for commercial R&D, university laboratories, and competitive entertainment.',
  ogImage = 'https://juvantia.org/images/hero.jpg',
} = Astro.props;

const pathname = currentPath(Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://juvantia.org${pathname === '/' ? '' : pathname}`} />
    <link rel="alternate" type="text/markdown" title="LLM-friendly version" href="/llms.txt" />

    <!-- Favicons -->
    <!-- Static files are cached for a year (immutable): a changed icon gets a new version in its address. -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20261020" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=20261020" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=20261020" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20261020" />
    <link rel="manifest" href="/site.webmanifest?v=20261020" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://juvantia.org${pathname}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: Barlow Condensed shown, Space Grotesk pressed and read; the wordmark is an SVG and needs no font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- Theme color -->
    <meta name="theme-color" content="#040908" />
    <ClientRouter />
  </head>

  <body>
    <svg class="vt-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="vt-brand-ink" gradientUnits="userSpaceOnUse" x1="2" y1="12" x2="22" y2="12">
          <stop offset="0" stop-color="#00ff88"></stop>
          <stop offset="1" stop-color="#00d4ff"></stop>
        </linearGradient>
      </defs>
    </svg>

    <!-- The world behind every page: the land, two carriers of light, grain and the broadcast raster. It stays between pages. -->
    <div class="vt-world" aria-hidden="true" transition:persist="vt-world">
      <div class="vt-world-land"><canvas class="vt-relief"></canvas></div>
      <div class="vt-carriers"></div>
      <div class="vt-grain"></div>
      <div class="vt-raster"></div>
    </div>

    <TopDock pathname={pathname} />

    <div class="site" id="top">
      <slot name="stage">
        <div class="gutter"><SiteHeader pathname={pathname} /></div>
      </slot>
      <main class="site-main gutter">
        <slot />
      </main>
      <SiteFooter pathname={pathname} />
    </div>

    <PhoneDock pathname={pathname} />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

---
import MainLayout from '../layouts/MainLayout.astro';
import DeckKey from '../components/vitrum/DeckKey.astro';
import '../styles/pages/lost.css';
---

<MainLayout title="404 - Sector Not Found | Juvantia">
  <div class="lost wrap">
    <p class="lost-code" aria-hidden="true">404</p>
    <h1 class="lost-title">Sector not found</h1>
    <p class="lost-text">The coordinates you requested do not exist within the Juvantia network. Your rover has drifted into unmapped territory.</p>
    <DeckKey class="key--access lost-key" href="/" title="Return to base" />
  </div>
</MainLayout>

---
import MainLayout from '../layouts/MainLayout.astro';
import PageHead from '../components/vitrum/PageHead.astro';
import Plate from '../components/vitrum/Plate.astro';
import DeckKey from '../components/vitrum/DeckKey.astro';
import Icon from '../components/vitrum/Icon.astro';
import '../styles/pages/downloads.css';

type Platform = 'apple' | 'google-play' | 'android' | 'windows' | 'linux';

interface Download {
  id: string;
  note: string;
  title: string;
  icon: Platform;
  url?: string;
}

// The Citizen app is not published yet: its keys stand without light until a store link exists.
const CITIZEN: Download[] = [
  { id: 'app-store', note: 'Download on the', title: 'App Store', icon: 'apple' },
  { id: 'google-play', note: 'Get it on', title: 'Google Play', icon: 'google-play' },
  { id: 'apk-download', note: 'Direct package', title: 'Android APK', icon: 'android' },
];

const DECK: Download[] = [
  { id: 'macos', note: 'Available for', title: 'macOS', icon: 'apple', url: 'https://releases.juvantia.org/OPERATOR-DECK-latest-universal.dmg' },
  { id: 'windows', note: 'Get it for', title: 'Windows', icon: 'windows', url: 'https://apps.microsoft.com/detail/9PGZ8LQ3V91B' },
  { id: 'linux', note: 'Get it for', title: 'Linux', icon: 'linux', url: 'https://releases.juvantia.org/OPERATOR-DECK-latest-x86_64.AppImage' },
];

// The QR placeholder as the site always had it: finder squares and a scatter of modules on a 29 × 29 grid.
const QR_MODULES = [
  [10, 4, 1, 1], [12, 4, 1, 1], [14, 4, 1, 1], [16, 4, 1, 1], [4, 10, 1, 1], [4, 12, 1, 1], [4, 14, 1, 1], [4, 16, 1, 1],
  [10, 2, 2, 1], [14, 2, 1, 2], [17, 2, 2, 1], [10, 6, 3, 1], [15, 6, 2, 2], [18, 5, 1, 3], [2, 10, 2, 1], [6, 10, 1, 2],
  [8, 10, 2, 1], [11, 9, 3, 2], [16, 9, 2, 1], [20, 10, 3, 1], [25, 10, 2, 1], [2, 13, 1, 2], [5, 12, 2, 1], [8, 13, 1, 2],
  [10, 12, 2, 2], [13, 12, 2, 1], [17, 12, 3, 1], [22, 12, 2, 2], [26, 12, 1, 2], [3, 16, 2, 1], [7, 15, 2, 2], [10, 15, 1, 3],
  [12, 15, 3, 1], [16, 15, 2, 2], [19, 15, 2, 1], [23, 15, 3, 1], [10, 19, 2, 1], [13, 18, 1, 2], [15, 19, 2, 1], [18, 18, 1, 2],
  [10, 21, 3, 1], [14, 21, 2, 2], [17, 21, 2, 1], [10, 23, 1, 3], [12, 24, 2, 1], [15, 23, 3, 1], [19, 24, 2, 2], [26, 22, 1, 3],
  [11, 26, 2, 1], [14, 26, 3, 1], [18, 26, 2, 1], [21, 26, 3, 1], [25, 26, 2, 1],
];
const FINDERS = [[2, 2], [20, 2], [2, 20]];
---

<MainLayout
  title="Downloads — JUVANTIA"
  description="Download official Juvantia ecosystem client applications for mobile (Juvantia Citizen) and desktop (Juvantia Operator Deck)."
  ogImage="https://juvantia.org/images/hero.jpg"
>
  <PageHead title="Downloads" />

  <div class="page-section wrap">
    <div class="plates">
      <Plate id="citizen" title="Juvantia Citizen">
        <div class="download-row">
          <div class="download-keys">
            {CITIZEN.map((item) => (
              <DeckKey class="key--download" note={item.note} title={item.title} disabled>
                <Icon name={item.icon} slot="icon" />
              </DeckKey>
            ))}
          </div>
          <figure class="download-qr">
            <svg width="88" height="88" viewBox="0 0 29 29" shape-rendering="crispEdges" aria-hidden="true">
              <rect width="29" height="29" fill="#ffffff" />
              {FINDERS.map(([x, y]) => (
                <>
                  <rect x={x} y={y} width="7" height="7" fill="#050a09" />
                  <rect x={x + 1} y={y + 1} width="5" height="5" fill="#ffffff" />
                  <rect x={x + 2} y={y + 2} width="3" height="3" fill="#050a09" />
                </>
              ))}
              <rect x="20" y="20" width="5" height="5" fill="#050a09" />
              <rect x="21" y="21" width="3" height="3" fill="#ffffff" />
              <rect x="22" y="22" width="1" height="1" fill="#050a09" />
              <g fill="#050a09">
                {QR_MODULES.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
              </g>
            </svg>
            <figcaption>Scan to open on phone</figcaption>
          </figure>
        </div>
      </Plate>

      <Plate id="operator-deck" title="Juvantia Operator Deck">
        <div class="download-keys">
          {DECK.map((item) => (
            <DeckKey class="key--download" href={item.url} note={item.note} title={item.title} external chevron="out">
              <Icon name={item.icon} slot="icon" />
            </DeckKey>
          ))}
        </div>
      </Plate>
    </div>
  </div>
</MainLayout>

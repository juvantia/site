---
import MainLayout from '../layouts/MainLayout.astro';
import PageHead from '../components/vitrum/PageHead.astro';
import Plate from '../components/vitrum/Plate.astro';
---

<MainLayout
  title="Legal — JUVANTIA"
  description="Legal information, terms, and conditions for the JUVANTIA proving ground and park."
>
  <PageHead title="Legal information" />

  <div class="page-section wrap">
    <div class="plates plates--narrow">
      <Plate id="privacy" title="Privacy Policy">
        <span class="vt-plate-label" slot="meta">Last updated: December 2025</span>
        <p class="plate-text">At Juvantia Foundation, we believe in minimizing data collection. We do not use third-party tracking cookies, analytics services, or advertising pixels. This means we do not track your behavior across the internet.</p>
        <ul class="row-list">
          <li>
            <h3 class="row-title">Data we collect</h3>
            <p class="row-text">When you submit a Memorandum of Intent or register, we collect the information you explicitly provide: Name, Email, Experience details, and uploaded photos.</p>
          </li>
          <li>
            <h3 class="row-title">How we use it</h3>
            <p class="row-text">We use this data solely to process your application, verify your eligibility for the compound, and contact you regarding your citizenship status. We do not sell or share your data with third parties.</p>
          </li>
        </ul>
      </Plate>

      <Plate id="terms" title="Terms of Service">
        <ul class="row-list">
          <li>
            <h3 class="row-title">1. The Project</h3>
            <p class="row-text">Juvantia is an experimental robotic compound project. All timelines (including the 2027 target) are estimates and goals, not guarantees.</p>
          </li>
          <li>
            <h3 class="row-title">2. Contributions</h3>
            <p class="row-text">By submitting designs, code, or applications, you agree that you have the right to share them. We respect your intellectual property, but by participating in the "res publica" (public affairs) of Juvantia, you agree to act in accordance with the project's Constitution.</p>
          </li>
          <li>
            <h3 class="row-title">3. User Conduct</h3>
            <p class="row-text">We reserve the right to reject memorandums or revoke digital citizenship for behavior that violates our community standards or the Constitution.</p>
          </li>
        </ul>
      </Plate>
    </div>
  </div>
</MainLayout>
